# Juda React Frontend Environment Variables Template
# ----------------------------------------------------
# Copy this file to '.env' and fill in your client-side Firebase credentials.
#
# To locate these values:
# 1. Open the Firebase Console (https://console.firebase.google.com/)
# 2. Select project 'juda-497014'
# 3. Click Gear Icon (Settings) -> Project Settings
# 4. Scroll down to "Your Apps" and locate your Web App config block.
# 5. Copy the corresponding parameters into the variables below:

# 1. Firebase Client Web App API Key
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY_HERE"

# 2. Pre-calculated Auth Domain (juda-497014.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN="juda-497014.firebaseapp.com"

# 3. Firebase Project ID
VITE_FIREBASE_PROJECT_ID="juda-497014"

# 4. Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET="juda-497014.appspot.com"

# 5. Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID_HERE"

# 6. Web App ID
VITE_FIREBASE_APP_ID="YOUR_WEB_APP_ID_HERE"
