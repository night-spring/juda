# Juda Environment Variables Template

# 1. Hugging Face Access Token API Key
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# 2. Firebase Service Account Credentials Path
# Obtain a private key JSON from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Specify the absolute or relative path to that JSON file here.
FIREBASE_CREDENTIALS_PATH=path/to/firebase-service-account-key.json

# Optional: Host and Port configurations (defaults to 127.0.0.1 and 8000)
HOST=127.0.0.1
PORT=8000
