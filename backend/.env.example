# Juda Environment Variables Template

# 1. Hugging Face Access Token API Key
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# 2. Firebase Service Account Credentials
# Create a service account in the Firebase Console (https://console.firebase.google.com/)
# and download the JSON key file. Then, set the following variables:
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Optional: Host and Port configurations (defaults to 127.0.0.1 and 8000)
HOST=127.0.0.1
PORT=8000
